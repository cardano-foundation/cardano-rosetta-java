#!/usr/bin/env bash
#
# Enforces Conventional Commits (https://www.conventionalcommits.org) on the
# commit subject line:
#
#   type(optional-scope)!: description
#
# Types are case-insensitive, as the spec requires; "!" marks a breaking change.
# Messages git generates itself are allowed: "Merge ...", "Revert ...", and
# "fixup!/squash!/amend!" (for rebase --autosquash).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (not recommended):  git commit --no-verify

TYPES="build|ci|docs|feat|fix|perf|refactor|style|test|chore|revert"

# First line that is neither a comment nor blank.
subject=$(sed -n '/^#/d; /^[[:space:]]*$/d; p; q' "$1")

shopt -s nocasematch
[[ "$subject" =~ ^(${TYPES})(\([^\)]+\))?!?:\ .+ ]] && exit 0
[[ "$subject" =~ ^(Merge\ |Revert\ \"|(fixup|squash|amend)!\ ) ]] && exit 0

red="" green="" reset=""
if [ -t 2 ] && command -v tput >/dev/null 2>&1; then
  red=$(tput setaf 1) green=$(tput setaf 2) reset=$(tput sgr0)
fi
{
  echo ""
  echo "${red}[!] Commit blocked: message does not follow Conventional Commits.${reset}"
  echo "    got:      ${subject}"
  echo "    expected: type(scope): description      e.g.  fix(api): handle empty token bundle"
  echo "${green}[+]${reset} types:    ${TYPES//|/, }   (a trailing ! marks a breaking change, e.g. feat!: ...)"
  echo ""
} >&2
exit 1
