      "address": "addr_test1vz75nqeurq7nfgyzmgu4e4emrjqk7qn3jpaf7krzp09vd9qqw4flv5"
    }
  },
  "expected_error": {
    "code": 5067,
    "message": "Invalid address for resolve_smart_wallet_addr",
