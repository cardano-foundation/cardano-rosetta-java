{
  "test_name": "cip113 resolve base same user",
  "description": "A Base address whose stake key is the same user's key resolves to the same smart wallet as that user's Enterprise address",
  "network": "devkit",
  "endpoint": "/call",
  "request_body": {
    "network_identifier": {
      "blockchain": "cardano",
      "network": "{{networkId}}"
    },
    "method": "resolve_smart_wallet_addr",
    "parameters": {
      "address": "addr_test1qza5pudxg77g3sdaddecmw8tvc6hmynywn49lltt4fmvn7aafxpncxpaxjsg9k3etntnk8ypdup8ryr6navxyz72c62qqtznyz"
    }
  },
  "expected_response": {
    "result": {
      "account_identifier": {
        "address": "addr_test1zqvca3jpwpvrtd0fvexseqs55em0zg0zkr26hzs7e0qw6w9afxpncxpaxjsg9k3etntnk8ypdup8ryr6navxyz72c62qhg2h67"
      }
    },
    "idempotent": true
  }
}
