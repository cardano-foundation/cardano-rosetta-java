{
  "test_name": "(-) CIP-113 wrong-case address type",
  "description": "Negative test: address_type is case-sensitive, so \"cip113\" is rejected with the existing invalid-address-type error rather than a new code",
  "request_body": {
    "network_identifier": {
      "blockchain": "cardano",
      "network": "{{networkId}}"
    },
    "public_key": {
      "hex_bytes": "1B400D60AAF34EAF6DCBAB9BBA46001A23497886CF11066F7846933D30E5AD3F",
      "curve_type": "edwards25519"
    },
    "metadata": {
      "address_type": "cip113"
    }
  },
  "expected_error": {
    "code": 4016,
    "message": "Provided address type is invalid",
    "retriable": false
  }
}
