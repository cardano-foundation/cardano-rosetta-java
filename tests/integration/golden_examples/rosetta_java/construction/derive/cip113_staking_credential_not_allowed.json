{
  "test_name": "(-) CIP-113 staking credential not allowed",
  "description": "Negative test: CIP-113 derives the user credential from public_key, so a supplied metadata.staking_credential is rejected rather than ignored",
  "request_body": {
    "network_identifier": {
      "blockchain": "cardano",
      "network": "{{networkId}}"
    },
    "public_key": {
      "hex_bytes": "1B400D60AAF34EAF6DCBAB9BBA46001A23497886CF11066F7846933D30E5AD3F",
      "curve_type": "edwards25519"
    },
    "metadata": {
      "address_type": "CIP-113",
      "staking_credential": {
        "hex_bytes": "1B400D60AAF34EAF6DCBAB9BBA46001A23497886CF11066F7846933D30E5AD3F",
        "curve_type": "edwards25519"
      }
    }
  },
  "expected_error": {
    "code": 5062,
    "message": "metadata.staking_credential is not allowed for CIP-113 address derivation",
    "retriable": false
  }
}
